{
  "realm": "ticket-rush",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "buyer", "description": "Compra ingressos" },
      { "name": "organizer", "description": "Cadastra eventos e assentos" }
    ]
  },
  "defaultRoles": ["buyer"],
  "clients": [
    {
      "clientId": "ticket-rush-web",
      "name": "Ticket Rush",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8180/*"],
      "webOrigins": ["http://localhost:8180"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "ticket-rush-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticket-rush-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "buyer1",
      "email": "buyer1@ticketrush.local",
      "emailVerified": true,
      "firstName": "Comprador",
      "lastName": "Um",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["buyer"]
    },
    {
      "username": "buyer2",
      "email": "buyer2@ticketrush.local",
      "emailVerified": true,
      "firstName": "Comprador",
      "lastName": "Dois",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["buyer"]
    },
    {
      "username": "organizer1",
      "email": "organizer1@ticketrush.local",
      "emailVerified": true,
      "firstName": "Organizador",
      "lastName": "Um",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_USERS_PASSWORD}", "temporary": false }],
      "realmRoles": ["organizer"]
    }
  ]
}

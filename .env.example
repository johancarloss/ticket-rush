# Copy to .env and replace every value. Never commit .env.

TRAEFIK_HTTP_PORT=8180
TRAEFIK_DASHBOARD_PORT=8181
GRAFANA_PORT=8182
PROMETHEUS_PORT=8183
JAEGER_UI_PORT=8184
# Keycloak admin console, only on 127.0.0.1
KEYCLOAK_ADMIN_PORT=8185

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

INVENTORY_DB_PASSWORD=change-me
CHECKOUT_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
STATS_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Password of the test users buyer1, buyer2 and organizer1 (local development only)
KC_TEST_USERS_PASSWORD=change-me

# Password shared by the load-test accounts created by bots/cmd/testusers (never use these accounts outside tests)
LOAD_USERS_PASSWORD=change-me

# Purchase requests per second allowed per account in the Guard (ADR-002)
GUARD_RATE_LIMIT_PER_SECOND=10

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
